# Copy to deploy/.env (never commit it): docker compose substitutes ${…} from that file and passes it to every Worker
# container (migrate, collector-telegram, collector-alerts, processor). Locally export the values or use dotnet user-secrets.
POSTGRES_PASSWORD=puluj
# Service roles created by the migrations (initial password = role name). Change them in the database
# (ALTER ROLE puluj_reader PASSWORD '...') and put the new values here.
PULUJ_READER_PASSWORD=puluj_reader
PULUJ_ADMIN_PASSWORD=puluj_admin
# Admin panel (host port 8091; container port 8081): in Docker every request arrives from the container network, never from localhost, so the
# panel is unusable until this token is set (X-Admin-Token header / login form).
ADMIN_TOKEN=ADMIN_TOKEN

# alerts.in.ua API token (https://alerts.in.ua/api-request). Normally entered on the settings page (stored on the
# source row in the database); this env value is only a bootstrap fallback when the source has no token of its own.
Collectors__AlertsInUa__Enabled=false
Collectors__AlertsInUa__Token=
# One-off history load of every oblast (month_ago = the deepest the API offers, or week_ago); done once per period,
# progress in app_settings Runtime:AlertsInUa:History. Leave empty to skip.
Collectors__AlertsInUa__BackfillPeriod=

# Telegram MTProto (https://my.telegram.org). First login asks for a code: set Collectors__Telegram__VerificationCode
# or write it into <SessionPath>.code while the collector-telegram container waits (or enter it in the admin panel).
Collectors__Telegram__Enabled=false
Collectors__Telegram__ApiId=
Collectors__Telegram__ApiHash=
Collectors__Telegram__Phone=
Collectors__Telegram__Password=
Collectors__Telegram__SessionPath=/app/session/puluj-g.session

# LLM fallback parser (optional; rules run first, the model only when they find nothing)
Llm__Enabled=false
Llm__Model=claude-opus-5
ANTHROPIC_API_KEY=

# Correlation: broad candidate lookup is bounded separately from each class profile's scoring window.
Correlation__CandidateWindowMinutes=120
Correlation__AttachThreshold=0.6
Correlation__AmbiguityMargin=0.05

# RabbitMQ (ADR-0001, P02/P03): opt-in profile, `docker compose --profile broker up -d` starts rabbitmq + the `messaging`
# worker (roles relay,archive). The default deploy does not use it.
RABBITMQ_USER=puluj
RABBITMQ_PASSWORD=puluj
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# P03 DB-first bridge: collectors commit `raw.stored` into messaging.outbox together with the raw row (plan §11).
# Only with the broker profile running — otherwise the outbox grows and reconciliation alarms. Rollback: set false.
MESSAGING_OUTBOX_ENABLED=false
# P04 single ingress: collectors commit `ingress.received` + their checkpoint in one transaction and the `messaging` worker
# (role raw-writer) stores the raw rows. Requires the broker profile; supersedes the bridge. Rollback: set false.
MESSAGING_INGRESS_ENABLED=false
# P09 domain writers (ADR-0009 cutover). Do not edit by hand: scripts/deploy.ps1 -Broker -DomainWriters sets both
# (writers roles on the `messaging` worker, legacy processor scaled to 0) and the plain run restores the defaults.
# MESSAGING_WORKER_ROLES=relay,archive,raw-writer,normalizer,parser,llm-worker,finalizer
# PROCESSOR_REPLICAS=2

# Observability (optional): OTLP endpoint for traces/metrics
OTEL_EXPORTER_OTLP_ENDPOINT=
