{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puluj.local/contracts/messaging/schemas/events/parse.completed.schema.json",
  "title": "parse.completed payload",
  "description": "Чистий результат розпізнавання з metadata; без записів alerts/tracks (§4).",
  "type": "object",
  "required": [
    "raw_message_id",
    "attempt_id",
    "outcome",
    "method",
    "versions",
    "facts",
    "duration_ms"
  ],
  "properties": {
    "raw_message_id": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/uuid"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "facts",
        "no_facts",
        "unsupported",
        "needs_llm",
        "needs_review",
        "failed"
      ]
    },
    "method": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/analysisMethod"
    },
    "versions": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/versions"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_kind_code",
          "category",
          "confidence",
          "evidence"
        ],
        "properties": {
          "event_kind_code": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/eventKindCode"
          },
          "category": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/observationCategory"
          },
          "effective_at": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
          },
          "location": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/location"
          },
          "confidence": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/confidence"
          },
          "evidence": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/evidence"
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "fallback_reason": {
      "type": "string"
    },
    "error": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/error"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
