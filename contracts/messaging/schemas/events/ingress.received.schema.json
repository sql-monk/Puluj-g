{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puluj.local/contracts/messaging/schemas/events/ingress.received.schema.json",
  "title": "ingress.received payload",
  "description": "Collector → durable ingress. Повний текст/пейлоад або durable reference; до raw persistence raw_message_id відсутній (§5.1, §6.1).",
  "type": "object",
  "required": [
    "source_code",
    "source_message_key",
    "source_revision",
    "source_published_at",
    "received_at",
    "collector"
  ],
  "properties": {
    "source_code": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/sourceCode"
    },
    "source_message_key": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "legacy_source_message_id": {
      "type": "string",
      "description": "Значення, яке нинішній collector кладе в raw_messages.source_message_id (bridge, ADR-0003)"
    },
    "source_published_at": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
    },
    "received_at": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
    },
    "url": {
      "type": "string"
    },
    "content_hash": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/sha256",
      "description": "SHA-256(source_code, text, raw_payload) обчислений collector на оригінальному JSON (P04): raw-writer копіює його в raw_messages.hash, щоб direct і ingress режими давали той самий індекс схожості"
    },
    "text": {
      "type": "string"
    },
    "raw_payload": {
      "type": "object"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "checksum",
          "size_bytes",
          "content_type"
        ],
        "properties": {
          "uri": {
            "type": "string"
          },
          "checksum": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "content_type": {
            "type": "string"
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "description": "Cursor джерела, записаний тією ж транзакцією, що й outbox row (§6.1)"
    }
  },
  "anyOf": [
    {
      "required": [
        "text"
      ]
    },
    {
      "required": [
        "raw_payload"
      ]
    },
    {
      "required": [
        "attachments"
      ]
    }
  ]
}
