{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puluj.local/contracts/messaging/schemas/events/llm.completed.schema.json",
  "title": "llm.completed payload",
  "type": "object",
  "required": [
    "raw_message_id",
    "request_id",
    "fencing_token",
    "model",
    "prompt_version",
    "outcome",
    "facts",
    "usage",
    "duration_ms"
  ],
  "properties": {
    "raw_message_id": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/uuid"
    },
    "provider_request_id": {
      "type": "string"
    },
    "fencing_token": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/fencingToken"
    },
    "model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "facts",
        "no_facts",
        "needs_review"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_kind_code",
          "category",
          "confidence",
          "evidence"
        ],
        "properties": {
          "event_kind_code": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/eventKindCode"
          },
          "category": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/observationCategory"
          },
          "effective_at": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
          },
          "location": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/location"
          },
          "confidence": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/confidence"
          },
          "evidence": {
            "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/evidence"
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
