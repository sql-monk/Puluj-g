{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puluj.local/contracts/messaging/schemas/events/message.analysis.completed.schema.json",
  "title": "message.analysis.completed payload",
  "description": "Terminal результат extraction; обов'язковий для no_facts/unsupported/needs_review/failed (§4).",
  "type": "object",
  "required": [
    "raw_message_id",
    "outcome",
    "method",
    "fact_count",
    "expected_branches",
    "versions",
    "timings"
  ],
  "properties": {
    "raw_message_id": {
      "type": "integer",
      "minimum": 1
    },
    "extraction_result_id": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/uuid"
    },
    "outcome": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/analysisOutcome"
    },
    "method": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/analysisMethod"
    },
    "fact_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_branches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "track-worker",
          "alert-worker",
          "incident-worker"
        ]
      },
      "uniqueItems": true
    },
    "versions": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/versions"
    },
    "timings": {
      "type": "object",
      "properties": {
        "received_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        },
        "stored_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        },
        "normalized_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        },
        "parsed_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        },
        "llm_completed_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        },
        "finalized_at": {
          "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/dateTime"
        }
      },
      "required": [
        "finalized_at"
      ]
    },
    "error": {
      "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/error"
    },
    "llm_request_ids": {
      "type": "array",
      "items": {
        "$ref": "https://puluj.local/contracts/messaging/schemas/common.schema.json#/$defs/uuid"
      }
    }
  }
}
