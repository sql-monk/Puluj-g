{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puluj.local/contracts/messaging/schemas/common.schema.json",
  "title": "Спільні визначення payload-схем",
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceCode": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "sources.code" },
    "eventKindCode": { "type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)+$", "description": "event_kinds.code (§8.2), напр. target.observed, alert.air_raid.started" },
    "observationCategory": { "type": "string", "enum": ["target", "alert", "incident", "info"], "description": "Визначає доменну гілку за completion-manifest.json" },
    "analysisOutcome": { "type": "string", "enum": ["completed", "no_facts", "unsupported", "needs_review", "failed"] },
    "analysisMethod": { "type": "string", "enum": ["structured", "rules", "llm", "mixed", "none"] },
    "locationKind": { "type": "string", "enum": ["unknown", "direction_only", "region", "district", "city", "area", "point"] },
    "location": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/locationKind" },
        "place_id": { "type": "integer", "minimum": 1 },
        "geometry": { "type": "object", "description": "GeoJSON geometry; лише з достатнім evidence (§8.5)" },
        "accuracy_km": { "type": "number", "minimum": 0 },
        "text": { "type": "string" }
      }
    },
    "confidence": { "type": "string", "enum": ["unknown", "low", "medium", "high", "confirmed"] },
    "evidence": {
      "type": "object",
      "properties": {
        "span": { "type": "object", "required": ["start", "end"], "properties": { "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 } } },
        "rule_id": { "type": "string" },
        "rule_version": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "structured_field": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["observation_id", "event_kind_code", "category", "effective_at", "confidence", "evidence"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/uuid" },
        "legacy_target_id": { "type": "integer", "minimum": 1, "description": "targets.target_id під час compatibility window (§8.1)" },
        "event_kind_code": { "$ref": "#/$defs/eventKindCode" },
        "category": { "$ref": "#/$defs/observationCategory" },
        "effective_at": { "$ref": "#/$defs/dateTime", "description": "Коли факт діє за даними джерела (§8.5)" },
        "location": { "$ref": "#/$defs/location" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "attributes": { "type": "object", "description": "Kind-specific поля (target class/model/direction, alert scope, severity)" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "versions": {
      "type": "object",
      "properties": {
        "normalization": { "type": "string" },
        "rules": { "type": "string" },
        "ruleset_id": { "type": "string" },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "catalog_policy": { "type": "string" }
      }
    },
    "fencingToken": { "type": "integer", "minimum": 1, "description": "Монотонний токен lease (ADR-0004 W8): результат зі старим токеном відкидається." }
  }
}
