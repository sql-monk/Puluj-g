{
  "ConnectionStrings": {
    "Puluj": "Host=localhost;Port=5442;Database=puluj;Username=puluj;Password=puluj"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Worker": {
    "Name": "worker",
    "Roles": ""
  },
  "Processing": {
    "PendingPollInterval": "00:00:10",
    "MaxAttempts": 3,
    "Concurrency": 2,
    "ClaimLease": "00:05:00",
    "MaxTransientRetries": 10
  },
  "Collectors": {
    "AlertsInUa": {
      "Enabled": false,
      "PollingInterval": "00:00:30"
    },
    "Telegram": {
      "Enabled": false,
      "SessionPath": "session/puluj.session",
      "AutoJoin": true,
      "BackfillLimit": 30,
      "BackfillSince": null,
      "HistoryWorkers": 2,
      "RpcTimeout": "00:00:30",
      "HistoryRequestInterval": "00:00:00.500",
      "HistoryMinimumInterval": "00:00:00.500",
      "HistoryMaximumInterval": "00:00:08"
    }
  },
  "Llm": {
    "Enabled": false,
    "Provider": "Anthropic",
    "Anthropic": {
      "Model": "claude-opus-5",
      "InputUsdPerMillionTokens": 5,
      "OutputUsdPerMillionTokens": 25,
      "CacheWriteUsdPerMillionTokens": 6.25,
      "CacheReadUsdPerMillionTokens": 0.5
    },
    "OpenAI": {
      "Model": "gpt-5-mini"
    },
    "Ollama": {
      "Model": "qwen3:8b",
      "BaseUrl": "http://localhost:11434/v1"
    },
    "TimeoutSeconds": 20,
    "MaxCallsPerMinute": 20,
    "MaxMessageAgeHours": 72,
    "FailurePause": "00:15:00",
    "PromptVersion": "1"
  },
  "EntityExtractor": {
    "Url": "http://entity-extractor:8080",
    "Token": null,
    "DeliveryTimeout": "00:00:30",
    "PollingInterval": "00:00:02",
    "ClaimLease": "00:16:00",
    "Concurrency": 4
  },
  "Correlation": {
    "CandidateWindowMinutes": 120,
    "DuplicateWindow": "00:03:00",
    "AttachThreshold": 0.6,
    "AmbiguityMargin": 0.05,
    "SlackKm": 8,
    "CoarseLocationAccuracyKm": 80,
    "CloseAfterWindows": 2,
    "WatchdogInterval": "00:01:00"
  },
  "Seed": {
    "DataDirectory": "data"
  }
}
