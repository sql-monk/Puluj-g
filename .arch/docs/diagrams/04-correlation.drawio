<mxfile host="puluj" modified="2026-09-11T00:00:00.000Z" agent="build.py" version="24.0.0"><diagram id="04-correlation" name="Кореляція нового Target"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="in" value="Target (TargetObserved, з категорією)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="30" width="300" height="50" as="geometry"/></mxCell><mxCell id="dup" value="є таке саме за ±3 хв&lt;br&gt;з іншого повідомлення?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="180" height="80" as="geometry"/></mxCell><mxCell id="dupY" value="Дублікат&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;duplicate_of = оригінал; прив&#x27;язати до його треку (provenance); інше джерело → +1 до впевненості оригіналу&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="300" height="70" as="geometry"/></mxCell><mxCell id="cand" value="Кандидати: активні треки тієї ж категорії,&lt;br&gt;сумісний клас, last_seen ±2 год&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;без якоря (ні район, ні пункт) → треку немає; трек, який у цьому ж повідомленні вже продовжила інша ціль, не бере&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="300" height="80" as="geometry"/></mxCell><mxCell id="score" value="Скоринг кожного кандидата&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;0.30·час (вікно класу) + 0.35·простір (розрив між площами якорів, полігони областей, ≤ швидкість×Δt + 30 км) + 0.15·напрямок + 0.20·клас/модель&lt;br&gt;= 0 якщо стрибок неможливий, немає якоря або те саме джерело за &amp;lt; 8 хв назвало інший пункт&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="300" height="110" as="geometry"/></mxCell><mxCell id="thr" value="найкращий ≥ 0.6 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="180" height="80" as="geometry"/></mxCell><mxCell id="new" value="Новий TargetTrack&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;association_confidence = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="300" height="60" as="geometry"/></mxCell><mxCell id="att" value="Приєднати до треку&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;класифікація лише уточнюється; новіший → last_location, шлях, напрямок; старіший → тільки provenance; association_reason зберігає розклад балів&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="590" width="300" height="80" as="geometry"/></mxCell><mxCell id="conf" value="track_confidence = найкраща target&lt;br&gt;+1 за ≥2 джерела, +1 за ≥3 повідомлення" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="300" height="60" as="geometry"/></mxCell><mxCell id="rev" value="Revision (час події) → NOTIFY TrackUpserted" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="790" width="300" height="50" as="geometry"/></mxCell><mxCell id="links" value="БД, тригер на targets: target_links&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;попередники у вікні класу, які могли долетіти на крейсерській швидкості (розрив між площами, розворот до 4 хв); ймовірності нормовані до суми ≤ 1; дубль = 1. Сліди на карті — лише з цих зв&#x27;язків. Той самий тригер веде копії джерел і їх рейтинг.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="800" y="520" width="280" height="110" as="geometry"/></mxCell><mxCell id="close1" value="Відбій тривоги / «загроза минула»&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;закриває активні треки в тій області (Cancelled)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="280" height="70" as="geometry"/></mxCell><mxCell id="close2" value="TrackWatchdog (щохвилини)&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;без оновлень 2 × вікно класу → Closed(timeout)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="280" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Вікна класів: БпЛА 60 хв, крилаті 25 хв, балістика 10 хв (TargetClass.Metadata, змінюється в БД)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="280" height="80" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="in" target="dup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dup" target="dupY"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="dup" target="cand"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="cand" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="score" target="thr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="ні" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="thr" target="new"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="так" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="thr" target="att"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="att" target="conf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="new" target="conf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="dupY" target="conf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="conf" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>