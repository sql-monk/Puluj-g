<mxfile host="puluj" modified="2026-09-11T00:00:00.000Z" agent="build.py" version="24.0.0"><diagram id="02-pipeline" name="Шлях повідомлення"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="raw" value="RawMessage (Pending)&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;оригінальний текст/payload, незмінний&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="30" width="300" height="50" as="geometry"/></mxCell><mxCell id="kind" value="структурований&lt;br&gt;payload?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="70" as="geometry"/></mxCell><mxCell id="alert" value="AlertsInUaHandler&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;AirAlert + Target(AirRaidAlert/AlertCancelled), без NLP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="240" height="60" as="geometry"/></mxCell><mxCell id="norm" value="Normalizer&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;NFC, emoji→слова, lower-case, речення → сегменти, токени&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="300" height="60" as="geometry"/></mxCell><mxCell id="rule" value="RuleParser&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;aliases (стеми) · газетир (місце + роль: з / на / курсом на) · напрямок · кількість · тип події · hedge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="300" height="70" as="geometry"/></mxCell><mxCell id="any" value="є факти?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="160" height="70" as="geometry"/></mxCell><mxCell id="llm" value="LlmParser (fallback)&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;лише коли правила мовчать, а текст схожий на загрозу; тільки коди з таксономії&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="405" width="240" height="60" as="geometry"/></mxCell><mxCell id="bld" value="TargetBuilder&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;рівень класифікації + впевненість (обмежена довірою джерела); район ≠ точка; напрямок; metadata «чому»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="300" height="70" as="geometry"/></mxCell><mxCell id="obs" value="Target" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="300" height="50" as="geometry"/></mxCell><mxCell id="dedup" value="Deduplicator&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;те саме місце/клас/подія ±3 хв з іншого повідомлення → дублікат (зберігається)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="300" height="60" as="geometry"/></mxCell><mxCell id="corr" value="Correlator&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;скоринг проти активних треків: час · простір · напрямок · клас ≥ 0.6 → приєднати, інакше новий трек&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="300" height="70" as="geometry"/></mxCell><mxCell id="trk" value="TargetTrack + TargetTrackRevision&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ревізія = знімок для історії (час події)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="870" width="300" height="60" as="geometry"/></mxCell><mxCell id="ntf" value="COMMIT → NOTIFY puluj_events → SignalR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="960" width="300" height="50" as="geometry"/></mxCell><mxCell id="err" value="Помилка стадії&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;rollback, processing_errors, attempts++; після 3 спроб — Failed. Решта повідомлень не чекає&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="240" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Кожне повідомлення може дати 0..N targets (по одному на сегмент/загрозу). Повідомлення без фактів — теж результат (метрика parser.unmatched)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="260" height="90" as="geometry"/></mxCell><mxCell id="c3" value="Тривоги/відбої з тексту не створюють AirAlert (це робить лише alerts.in.ua), але «відбій» закриває треки в області." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="260" height="110" as="geometry"/></mxCell><mxCell id="c4