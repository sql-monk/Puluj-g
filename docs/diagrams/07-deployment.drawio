<mxfile host="puluj" modified="2026-09-11T00:00:00.000Z" agent="build.py" version="24.0.0"><diagram id="07-deployment" name="Puluj-G: Docker-порти та перший запуск порожньої БД"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="host" value="Host / оператор" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="260" height="560" as="geometry"/></mxCell><mxCell id="cmd" value="docker compose -p puluj-g&lt;br&gt;-f deploy/docker-compose.yml up --build" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="55" y="80" width="210" height="65" as="geometry"/></mxCell><mxCell id="browser" value="Браузер&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;карта localhost:8090&lt;br&gt;адмінка localhost:8091&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="55" y="185" width="210" height="80" as="geometry"/></mxCell><mxCell id="diag" value="Локальна діагностика БД&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;localhost:5442 (psql, tests)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="55" y="310" width="210" height="70" as="geometry"/></mxCell><mxCell id="c2" value="Ці порти не перетинаються з базовим Puluj на 5432 / 8080 / 8081. Локальний запуск без Docker використовує 5267 / 5268 / 5269." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555