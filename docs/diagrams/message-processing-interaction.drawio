        <mxCell id="12" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="120" as="sourcePoint"/><mxPoint x="672" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="13" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="120" as="sourcePoint"/><mxPoint x="920" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="14" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="130" as="sourcePoint"/><mxPoint x="1220" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="15" style="html=1;dashed=1;strokeColor=#999999;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1498" y="120" as="sourcePoint"/><mxPoint x="1498" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="20" value="1. BEGIN: ingress.received + checkpoint" style="html=1;endArrow=block;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122" y="180" as="sourcePoint"/><mxPoint x="400" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="21" value="2. commit: durable outbox row is visible" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="250" as="sourcePoint"/><mxPoint x="672" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="22" value="3. lease outbox rows" style="html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="320" as="sourcePoint"/><mxPoint x="400" y="320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="23" value="4. publish event_id (persistent, mandatory)" style="html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="390" as="sourcePoint"/><mxPoint x="920" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="24" value="5. publisher confirm" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="460" as="sourcePoint"/><mxPoint x="672" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="25" value="6. mark confirmed_at" style="html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="530" as="sourcePoint"/><mxPoint x="400" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="26" value="7. deliver event" style="html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="600" as="sourcePoint"/><mxPoint x="1220" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="27" value="8. BEGIN: inbox check + effect/receipt + next outbox rows" style="html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="670" as="sourcePoint"/><mxPoint x="400" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="28" value="9. COMMIT" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="740" as="sourcePoint"/><mxPoint x="1220" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="29" value="10. ACK лише після commit" style="html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="810" as="sourcePoint"/><mxPoint x="920" y="810" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="30" value="Наступні outbox-події проходять той самий relay loop до domain worker; він комітить доменний ефект і receipt, після чого read-side може надіслати best-effort notification." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1335" y="350" width="240" height="160" as="geometry"/></mxCell>
        <mxCell id="31" value="Redelivery до confirm/mark або до ACK є очікуваною. Унікальна пара subscription + event у inbox/receipt перетворює її на no-op для вже committed ефекту; transport лишається at-least-once." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="55" y="850" width="1520" height="75" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
