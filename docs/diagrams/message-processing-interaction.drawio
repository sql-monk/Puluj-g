        <mxCell id="7" value="Stage consumer&#xa;raw-writer / normalizer / parser / finalizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1105" y="65" width="230" height="65" as="geometry"/></mxCell>
