        <mxCell id="4" value="PostgreSQL&#xa;ingress / outbox / inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="75" width="180" height="45" as="geometry"/></mxCell>
