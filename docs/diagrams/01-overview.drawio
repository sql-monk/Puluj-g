<mxfile host="puluj" modified="2026-09-11T00:00:00.000Z" agent="build.py" version="24.0.0"><diagram id="01-overview" name="Огляд системи"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gS" value="Джерела (OSINT)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="200" height="250" as="geometry"/></mxCell><mxCell id="alerts" value="alerts.in.ua&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;REST, опитування 30 с&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="160" height="50" as="geometry"/></mxCell><mxCell id="tg" value="Telegram-канали&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;MTProto, live + історія&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="160" height="50" as="geometry"/></mxCell><mxCell id="rss" value="RSS / web&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;(інтерфейс готовий)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="160" height="50" as="geometry"/></mxCell><mxCell id="gW" value="Puluj.Worker" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="300" height="470" as="geometry"/></mxCell><mxCell id="col" value="Collectors + Supervisor&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;кожен колектор — окрема задача, backoff при збої&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="ing" value="RawMessageIngestor&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;INSERT … ON CONFLICT DO NOTHING (ідемпотентно)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="260" height="50" as="geometry"/></mxCell><mxCell id="prs" value="Normalizer → RuleParser (+LLM fallback)&lt;br&gt;→ TargetBuilder&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;текст → факти → Target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="260" height="60" as="geometry"/></mxCell><mxCell id="cor" value="Deduplicator → Correlator&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Target → TargetTrack + Revision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="260" height="60" as="geometry"/></mxCell><mxCell id="wd" value="TrackWatchdog / IndexProvider&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;закриття треків за таймаутом; кеш таксономії та газетира&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="260" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Один процес, кілька фонових служб. Обробка одного повідомлення — одна транзакція; після COMMIT публікується NOTIFY." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="260" height="60" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL + PostGIS&lt;br&gt;&lt;br&gt;raw_messages&lt;br&gt;targets · target_links&lt;br&gt;target_tracks&lt;br&gt;air_alerts · app_settings&lt;br&gt;places · таксономія · sources&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;єдине джерело істини&lt;br&gt;ролі: puluj (owner, Worker) · puluj_reader (Api) · puluj_admin (Admin)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;strokeWidth=1.2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="220" height="330" as="geometry"/></mxCell><mxCell id="gA" value="Puluj.Api (роль puluj_reader — лише читання)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="240" height="300" as="geometry"/></mxCell><mxCell id="rest" value="REST /api/*&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;local :5267 · Docker :8090→8080&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="200" height="50" as="geometry"/></mxCell><mxCell id="hub" value="SignalR /hubs/map&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;TrackUpserted, TrackClosed, AlertChanged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="200" height="50" as="geometry"/></mxCell><mxCell id="lst" value="LISTEN puluj_events&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;по події дочитує сутність з БД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="220" width="200" height="50" as="geometry"/></mxCell><mxCell id="spa" value="static: wwwroot (збірка web/)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="285" width="200" height="40" as="geometry"/></mxCell><mxCell id="gB" value="Браузер" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1220" y="40" width="200" height="300" as="geometry"/></mxCell><mxCell id="map" value="Карта (MapLibre)&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;тривоги, район, шлях, прогноз&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="160" height="60" as="geometry"/></mxCell><mxCell id="eta" value="ETA / fade&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;рахується локально; точка користувача не покидає браузер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="160" height="60" as="geometry"/></mxCell><mxCell id="hist" value="Історія / деталі&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;replay, джерела&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="240" width="160" height="50" as="geometry"/></mxCell><mxCell id="gM" value="Puluj.Admin (роль puluj_admin)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;dashed=1;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="370" width="240" height="210" as="geometry"/></mxCell><mxCell id="adm" value="REST /api/admin/*&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;local :5268 · Docker :8091→8081&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="410" width="200" height="50" as="geometry"/></mxCell><mxCell id="ops" value="Стан компонентів&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;heartbeat Worker, /api/health Api, колектори, БД&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="475" width="200" height="50" as="geometry"/></mxCell><mxCell id="adms" value="static: admin.html (збірка web/)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="940" y="535" width="200" height="35" as="geometry"/></mxCell><mxCell id="logs" value="logs/ (спільна тека)&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;worker-, api-, admin-&amp;lt;день&amp;gt;.log (Serilog)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="220" height="60" as="geometry"/></mxCell><mxCell id="padm" value="Адмін-панель&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;налаштування, статистика, логи&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="400" width="160" height="60" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;e