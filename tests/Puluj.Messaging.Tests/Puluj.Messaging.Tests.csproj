<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- P03: unit tests of registry/envelope against the contract schemas, and crash tests ADR-0004 P03-C01…C10 on a real
         PostGIS + RabbitMQ (Testcontainers). Infrastructure failures fail the suite: never a silent pass. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Puluj.Messaging\Puluj.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\contracts\messaging\schemas\**\*.json" LinkBase="contracts\messaging\schemas" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\contracts\messaging\fixtures\identity-cases.json" Link="contracts\messaging\fixtures\identity-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\contracts\messaging\fixtures\valid\raw.stored.json" Link="contracts\messaging\fixtures\valid\raw.stored.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\contracts\messaging\topology.json" Link="contracts\messaging\topology.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
